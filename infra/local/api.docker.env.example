# Contrato de la API cuando se ejecuta dentro de Docker Compose. PostgreSQL y
# Mailpit se alcanzan por su nombre de servicio, no mediante 127.0.0.1.
DATABASE_URL=postgres://tournaments_manager:change-me-local-only@postgres:5432/tournaments_manager?sslmode=disable
HTTP_ADDR=0.0.0.0:8080
SMTP_ADDR=mailpit:1025
SMTP_FROM=no-reply@tournaments-manager.local
# Mailpit no requiere autenticación. Para SMTP remoto, define ambas variables
# y el adaptador exigirá STARTTLS antes de autenticar.
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
GOOGLE_CLIENT_IDS=
# Tempo recibe trazas OTLP/HTTP en la red de Compose. Si se deja vacío, la API
# continúa operando y solo se desactiva la exportación de trazas.
OTEL_TRACES_ENDPOINT=http://tempo:4318/v1/traces
