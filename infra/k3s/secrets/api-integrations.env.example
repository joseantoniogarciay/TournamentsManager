# Integraciones de producción de la API.
# Copiar únicamente fuera de Git como
# /opt/homebrew/etc/fasttourney-prod-api-integrations.env, modo 0600.
# SMTP_PASSWORD es secreto; los IDs de Google son públicos en los clientes, pero
# viven aquí para que API y export web se habiliten como un mismo gate.
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-resend-production-sending-access-key
# La primera publicación web acepta solo el cliente web. Añade los IDs iOS y
# Android separados por comas cuando existan sus firmas de distribución.
GOOGLE_CLIENT_IDS=replace-with-production-google-web-client-id
