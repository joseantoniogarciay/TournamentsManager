# Contrato secreto de la API para el namespace prod.
# Copiar como api-runtime.env solo en el operador o en la VM; nunca versionar.
# La URL real contiene la credencial del rol runtime de PostgreSQL.
DATABASE_URL=postgres://replace-with-runtime-user:replace-with-runtime-password@postgresql.prod.svc.cluster.local:5432/fasttourney_prod?sslmode=disable

# Clave SMTP de envío. SMTP_ADDR, SMTP_FROM y SMTP_USERNAME no son secretos y
# pertenecerán al ConfigMap cuando sus valores de producción estén decididos.
SMTP_PASSWORD=replace-with-sending-access-key
