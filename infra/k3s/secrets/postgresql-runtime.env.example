# Contrato secreto de PostgreSQL para el namespace prod.
# Copiar como postgresql-runtime.env solo en el operador o en la VM; nunca
# versionar. Cada valor debe ser exclusivo de prod.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-admin-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-random-migrator-password
POSTGRES_APP_PASSWORD=replace-with-a-long-random-runtime-password
PGBACKREST_REPO1_CIPHER_PASS=replace-with-a-long-random-backup-passphrase
