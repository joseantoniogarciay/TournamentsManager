# Configuración local del operador K3s. Copiar a infra/k3s/.env y no versionar.
K3S_SSH_HOST=192.168.64.2
# Identidad no root administradora de la VM; véase ADR-0117. Durante el
# bootstrap inicial el fichero local conserva temporalmente la cuenta Ubuntu.
K3S_SSH_USER=fasttourney-operator
# Ruta local del Mac, fuera de Git; la réplica publicada pertenece solo a prod.
K3S_PGBACKREST_REPLICA_DESTINATION="/Users/your-user/Library/Mobile Documents/com~apple~CloudDocs/FastTourney/postgresql-backups/prod"
