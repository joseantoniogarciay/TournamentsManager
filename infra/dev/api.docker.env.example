# Contrato de la API runtime para tournaments-manager-dev.
# Copia como api.docker.env. Los datos son propios de este entorno y no se
# comparten con infra/local ni con producción.
DATABASE_URL=postgres://tournaments_manager_dev:replace-with-a-unique-dev-password@postgres:5432/tournaments_manager_dev?sslmode=disable
HTTP_ADDR=0.0.0.0:8080
# Mailpit solo escucha dentro de Compose; su UI queda ligada a 127.0.0.1:8026.
SMTP_ADDR=mailpit:1025
SMTP_FROM=no-reply@dev.fasttourney.com
PUBLIC_BASE_URL=https://dev.fasttourney.com
CORS_ALLOWED_ORIGINS=https://dev.fasttourney.com
GOOGLE_CLIENT_IDS=
