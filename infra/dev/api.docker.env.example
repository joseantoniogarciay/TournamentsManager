# Contrato de la API runtime para tournaments-manager-dev.
# Copia como api.docker.env. Los datos son propios de este entorno y no se
# comparten con infra/local ni con producción.
# Esta identidad solo tiene DML sobre el esquema de la API; la contraseña debe
# coincidir con POSTGRES_APP_PASSWORD de infra/dev/.env.
DATABASE_URL=postgres://tournaments_manager_dev_app:replace-with-a-unique-app-password@postgres:5432/tournaments_manager_dev?sslmode=disable
HTTP_ADDR=0.0.0.0:8080
# Resend SMTP autenticado con STARTTLS. Verifica primero el dominio remitente y
# guarda la clave Sending access solo en el archivo real, nunca en Git.
SMTP_ADDR=smtp.resend.com:587
SMTP_FROM=no-reply@mail.fasttourney.com
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-resend-sending-access-key
PUBLIC_BASE_URL=https://dev.fasttourney.com
CORS_ALLOWED_ORIGINS=https://dev.fasttourney.com
# Solo Docker Desktop puede entregar la IP que Caddy reenvía con X-Client-IP.
# No uses una red pública ni añadas IPs de clientes a esta lista.
TRUSTED_PROXY_CIDRS=172.19.0.1/32
GOOGLE_CLIENT_IDS=
