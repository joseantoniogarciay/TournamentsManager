# Solo para PostgreSQL de tournaments-manager-dev. Copia como .env y sustituye
# la contraseña antes de arrancar. No reutilices los valores del entorno local.
POSTGRES_DB=tournaments_manager_dev
POSTGRES_USER=tournaments_manager_dev
POSTGRES_PASSWORD=replace-with-a-unique-dev-password
# Roles separados para el entorno público. No reutilices estas contraseñas ni
# las publiques; APP coincide con DATABASE_URL de api.docker.env.
POSTGRES_OWNER_ROLE=tournaments_manager_dev_schema_owner
POSTGRES_MIGRATOR_USER=tournaments_manager_dev_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
POSTGRES_APP_USER=tournaments_manager_dev_app
POSTGRES_APP_PASSWORD=replace-with-a-unique-app-password
# Directorios locales del backup legal; el destino debe ser una carpeta privada
# de iCloud Drive y la clave debe permanecer fuera de iCloud y Git.
LEGAL_AUDIT_BACKUP_DESTINATION="/Users/your-user/Library/Mobile Documents/com~apple~CloudDocs/FastTourney/legal-audit-backups"
LEGAL_AUDIT_BACKUP_STATE_DIRECTORY=/Users/your-user/.config/fasttourney
LEGAL_AUDIT_BACKUP_KEY_PATH=/Users/your-user/.config/fasttourney/legal-audit-backup.key
# Backup físico completo de PostgreSQL: iCloud conserva el repositorio, pero el
# cifrado lo aplica pgBackRest con esta clave exclusiva y no sincronizada.
POSTGRES_BACKUP_DESTINATION="/Users/your-user/Library/Mobile Documents/com~apple~CloudDocs/FastTourney/postgresql-backups/dev"
PGBACKREST_REPO1_CIPHER_PASS=replace-with-a-long-random-postgresql-backup-passphrase
