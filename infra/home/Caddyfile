# Router HTTP local del Mac anfitrión.
#
# Cloudflare Tunnel termina el TLS público y alcanza este proceso por una
# conexión saliente. Caddy no escucha en la LAN ni en la WAN; conserva el
# enrutamiento por Host y la futura capacidad de proxy sin exponer la IP de casa.
{
	http_port 9080
}

(security_headers) {
	# Cloudflare termina TLS públicamente; este encabezado viaja con sus respuestas
	# HTTPS. No se incluyen subdominios ni preload hasta que todos estén publicados.
	header Strict-Transport-Security "max-age=31536000"
}

http://www.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	redir https://fasttourney.com{uri} 308
}

http://fasttourney.com {
	bind 127.0.0.1
	import security_headers
	respond "FastTourney todavía no está publicado.\n" 503
}

http://dev.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	header X-Robots-Tag "noindex, nofollow, noarchive"
	root * /opt/homebrew/var/www/fasttourney/dev
	try_files {path} /index.html
	file_server
}

http://api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	respond "La API de FastTourney todavía no está publicada.\n" 503
}

http://dev-api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	reverse_proxy 127.0.0.1:8081
}
