# Router HTTP local del Mac anfitrión.
#
# Cloudflare Tunnel termina el TLS público y alcanza este proceso por una
# conexión saliente. Caddy no escucha en la LAN ni en la WAN; conserva el
# enrutamiento por Host y la futura capacidad de proxy sin exponer la IP de casa.
{
	http_port 9080
}

(security_headers) {
	# Cloudflare termina TLS públicamente; este encabezado viaja con sus respuestas
	# HTTPS. No se incluyen subdominios ni preload hasta que todos estén publicados.
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
}

# La publicación real importa este fragmento solo después de validar el release
# preparado. Mantenerlo separado permite que el Caddyfile versionado conserve
# el 503 de producción hasta una decisión explícita de apertura.
(production_web) {
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.scalar.com; connect-src 'self' https://api.fasttourney.com https://accounts.google.com https://www.googleapis.com"
	# Solo la home es una superficie pública descubrible. Las rutas de aplicación,
	# incluidas las ligas leíbles por ID, no se convierten en resultados de búsqueda.
	@non_indexable_web_routes {
		not path / /robots.txt /sitemap.xml
	}
	header @non_indexable_web_routes X-Robots-Tag "noindex, nofollow, noarchive"
	handle /.well-known/* {
		root * /opt/homebrew/var/www/fasttourney/prod/current
		file_server
	}
	# Solo el documento raíz de una liga visible necesita metadatos dinámicos para
	# previews sociales. Las subrutas siguen siendo estáticas y la URL no cambia.
	@league_preview path_regexp league_preview ^/tournament/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$
	handle @league_preview {
		reverse_proxy 127.0.0.1:8091
	}
	handle {
		root * /opt/homebrew/var/www/fasttourney/prod/current
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

http://www.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	redir https://fasttourney.com{uri} 308
}

http://fasttourney.com {
	bind 127.0.0.1
	import security_headers
	import production_web
}

http://dev.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.scalar.com; connect-src 'self' https://dev-api.fasttourney.com https://accounts.google.com https://www.googleapis.com"
	handle_path /api-docs* {
		root * /opt/homebrew/var/www/fasttourney/dev/current/api-docs
		try_files {path} /index.html
		file_server
	}
	# El carril de desarrollo reproduce el preview de producción sin compartir
	# proceso, puerto, release ni API. Solo captura el documento raíz de una liga.
	@development_league_preview path_regexp development_league_preview ^/tournament/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$
	handle @development_league_preview {
		reverse_proxy 127.0.0.1:8092
	}
	handle {
		root * /opt/homebrew/var/www/fasttourney/dev/current
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

http://api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	reverse_proxy 192.168.64.2:80 {
		# Cloudflare Tunnel normaliza esta cabecera con la IP del visitante.
		header_up X-Client-IP {http.request.header.CF-Connecting-IP}
		# Fragmento privado, no versionado y requerido para publicar esta ruta.
		import /opt/homebrew/etc/fasttourney-api-edge-token.caddy
	}
}

http://dev-api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	reverse_proxy 127.0.0.1:8081 {
		# Cloudflare Tunnel normaliza esta cabecera con la IP del visitante.
		header_up X-Client-IP {http.request.header.CF-Connecting-IP}
	}
}
