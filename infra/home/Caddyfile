# Router HTTP local del Mac anfitrión.
#
# Cloudflare Tunnel termina el TLS público y alcanza este proceso por una
# conexión saliente. Caddy no escucha en la LAN ni en la WAN; conserva el
# enrutamiento por Host y la futura capacidad de proxy sin exponer la IP de casa.
{
	http_port 9080
}

(security_headers) {
	# Cloudflare termina TLS públicamente; este encabezado viaja con sus respuestas
	# HTTPS. No se incluyen subdominios ni preload hasta que todos estén publicados.
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
}

http://www.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	redir https://fasttourney.com{uri} 308
}

http://fasttourney.com {
	bind 127.0.0.1
	import security_headers
	respond "FastTourney todavía no está publicado.\n" 503
}

http://dev.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://dev-api.fasttourney.com https://accounts.google.com https://www.googleapis.com"
	root * /opt/homebrew/var/www/fasttourney/dev
	try_files {path} /index.html
	file_server
}

http://api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	respond "La API de FastTourney todavía no está publicada.\n" 503
}

http://dev-api.fasttourney.com {
	bind 127.0.0.1
	import security_headers
	reverse_proxy 127.0.0.1:8081 {
		# Cloudflare Tunnel normaliza esta cabecera con la IP del visitante.
		header_up X-Client-IP {http.request.header.CF-Connecting-IP}
	}
}
