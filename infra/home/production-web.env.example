# Configuración pública incorporada únicamente en la exportación web de prod.
# Copiar como infra/home/secrets/production-web.env (modo 0600, ignorado por Git).
# La web necesita solo su Client ID. Los IDs nativos se incorporan después,
# cuando existan sus credenciales de distribución reales.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-production-google-web-client-id
# Payment Links públicos live: se incorporan al bundle web, no son secretos.
# Solo rellenar los tres tras completar la validación de Stripe, fiscal y de
# copy de ADR-0129. Deben declararse los tres o ninguno; los enlaces test_ se
# rechazan en producción.
EXPO_PUBLIC_TIP_PAYMENT_LINK_2_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_5_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_10_EUR=
