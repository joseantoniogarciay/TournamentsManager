# Payment Links públicos de Stripe en modo Test para la exportación web de dev.
# Copiar como infra/home/secrets/development-web.env (modo 0600, ignorado por
# Git). Deben declararse los tres o ninguno; nunca uses aquí enlaces live.
# PostHog apagado en beta: el único proyecto se reserva para producción.
EXPO_PUBLIC_TIP_PAYMENT_LINK_2_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_5_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_10_EUR=

# Services ID público de Apple, compartido por web/iOS/Android del entorno.
# El placeholder mantiene el acceso deshabilitado hasta configurar el backend.
EXPO_PUBLIC_APPLE_SERVICE_ID=REPLACE_WITH_APPLE_SERVICE_ID
