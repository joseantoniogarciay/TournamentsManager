# Contrato de la API Go y de las migraciones locales.
# Copia este archivo como .env. El usuario, contraseña y base deben coincidir con
# infra/local/.env. Este valor es local; nunca lo publiques ni lo uses en otro
# entorno.
DATABASE_URL=postgres://tournaments_manager:change-me-local-only@127.0.0.1:5432/tournaments_manager?sslmode=disable
# Dirección en la que la API local escucha peticiones HTTP.
HTTP_ADDR=127.0.0.1:8080
# Mailpit local recibe el SMTP en el host. No uses esta configuración fuera del entorno local.
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=no-reply@tournaments-manager.local
# Mailpit no requiere autenticación. Para SMTP remoto, define ambas variables
# y el adaptador exigirá STARTTLS antes de autenticar.
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SUBJECT_PREFIX=
# Base pública del cliente que aparece en los enlaces de verificación. Fuera de
# loopback debe usar HTTPS y coincidir con el dominio asociado a las apps.
PUBLIC_BASE_URL=http://localhost:8082
# Orígenes web que pueden llamar a la API desde el navegador. No uses * cuando
# haya sesiones por cookie; producción debe declarar únicamente sus dominios.
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
# Vacío en local: ningún proxy presenta una IP de cliente reenviada.
TRUSTED_PROXY_CIDRS=
# IDs de cliente OAuth de Google separados por coma (web, iOS y Android). Si se
# deja vacío, el login federado queda deshabilitado de forma segura.
GOOGLE_CLIENT_IDS=
# URL OTLP/HTTP de trazas. Vacío desactiva solo la exportación: logs JSON y
# métricas continúan disponibles. El stack local usa Tempo en el puerto 4318.
OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
