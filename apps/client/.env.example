# Identificadores públicos OAuth de Google. No son secretos, pero deben pertenecer
# al proyecto FastTourney y coincidir con las audiencias aceptadas por el backend.
# Por defecto, APP_ENV=development usa https://dev.fasttourney.com y
# APP_ENV=production usa https://fasttourney.com. Solo define este valor para
# una sustitución temporal y HTTPS; no modifica la API local por defecto.
EXPO_PUBLIC_APP_LINK_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_GOOGLE_IOS_CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_GOOGLE_ANDROID_CLIENT_ID
# Proyecto PostHog UE 255144 reservado para producción. Beta/local no inician SDK.
# Clave pública de ingestión; nunca introducir una clave personal/CLI aquí.
EXPO_PUBLIC_POSTHOG_PRODUCTION_API_KEY=REPLACE_WITH_PRODUCTION_POSTHOG_PUBLIC_KEY
# Enlaces públicos de Stripe Payment Links para las propinas web de 2 €, 5 € y
# 10 €. No son secretos. La sección de apoyo solo aparece en web cuando los
# tres valores HTTPS se han configurado después de completar la revisión fiscal
# y de Stripe indicada en ADR-0129.
EXPO_PUBLIC_TIP_PAYMENT_LINK_2_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_5_EUR=
EXPO_PUBLIC_TIP_PAYMENT_LINK_10_EUR=

# Services ID público de Apple, compartido por web/iOS/Android del entorno.
# El placeholder mantiene el acceso deshabilitado hasta configurar el backend.
EXPO_PUBLIC_APPLE_SERVICE_ID=REPLACE_WITH_APPLE_SERVICE_ID
