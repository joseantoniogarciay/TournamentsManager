# Identificadores públicos OAuth de Google. No son secretos, pero deben pertenecer
# al proyecto FastTourney y coincidir con las audiencias aceptadas por el backend.
# Por defecto, APP_ENV=development usa https://dev.fasttourney.com y
# APP_ENV=production usa https://fasttourney.com. Solo define este valor para
# una sustitución temporal y HTTPS; no modifica la API local por defecto.
EXPO_PUBLIC_APP_LINK_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
