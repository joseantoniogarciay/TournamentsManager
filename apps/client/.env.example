# Identificadores públicos OAuth de Google. No son secretos, pero deben pertenecer
# al proyecto FastTourney y coincidir con las audiencias aceptadas por el backend.
# Origen HTTPS público usado por enlaces compartidos y asociaciones móviles.
# En desarrollo web se usa http://localhost:8081 si no se declara.
EXPO_PUBLIC_APP_LINK_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
