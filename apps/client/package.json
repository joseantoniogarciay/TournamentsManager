{
  "name": "@tournaments-manager/client",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_ENV=development expo start",
    "start:prod": "APP_ENV=production expo start",
